# Copy to .env when you want local API to read from AWS main database.
# IMPORTANT: use a read-only DB user if possible.

DATABASE_URL=postgresql://<readonly_user>:<password>@<aws-host>:5432/<db-name>?sslmode=require
SOURCE_DATABASE_URL=
REDIS_URL=redis://localhost:6380

PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Disable all startup writes when using production DB.
RUN_STARTUP_MIGRATIONS=false
RUN_STARTUP_SEED=false
ENABLE_MATCH_SYNC_WORKER=false

JWT_SECRET=matchwatch-dev-secret-key-change-in-production-32chars!
COOKIE_SECURE=false
AUTO_VERIFY_EMAIL=true
AUTH_RATE_LIMIT_MAX=200
PUBLIC_RATE_LIMIT_MAX=2000

CORS_ORIGINS=http://localhost:3100,http://localhost:3000,http://localhost:5173
APP_URL=http://localhost:3100

NEXT_PUBLIC_API_URL=/api/v1
API_PROXY_TARGET=http://localhost:4000

MATCH_SYNC_PROVIDER=THE_SPORTS_DB
FOOTBALL_DATA_API_KEY=
API_FOOTBALL_API_KEY=

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=matchwatch-uploads
CDN_URL=

RESEND_API_KEY=
EMAIL_FROM=noreply@matchwatch.us

FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_PASSWORD_HASH=
SUPER_ADMIN_SESSION_SECRET=dev-super-admin-session-secret-change-me

# Optional for anonymized local clone script
ANON_LOCAL_PASSWORD=Demo@12345
