{
    "name": "@matchwatch/api",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc && tsc-alias",
        "start": "node dist/index.js",
        "type-check": "tsc --noEmit",
        "lint": "echo 'No lint configured'",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:seed": "tsx src/db/seed.ts",
        "db:seed:demo-leagues": "tsx src/scripts/seedDemoLeagueMatches.ts",
        "db:ensure-leagues": "tsx src/scripts/ensureCoreLeagues.ts",
        "db:ensure-sports-leagues": "tsx src/scripts/ensureCoreLeagues.ts",
        "db:seed:anonymized": "tsx src/db/seed-anonymized.ts",
        "db:studio": "drizzle-kit studio",
        "matches:sync-upcoming": "tsx src/scripts/syncUpcomingMatches.ts",
        "matches:sync-backfill": "tsx src/scripts/syncUpcomingMatches.ts --sport=soccer --mode=backfill",
        "matches:sync-youtube-recaps": "tsx src/scripts/syncMatchYoutubeRecaps.ts",
        "venues:sync-google": "tsx src/scripts/syncGoogleVenueData.ts",
        "venues:restore-export-media": "tsx src/scripts/restoreVenueMediaFromExport.ts",
        "teams:backfill-logos": "tsx src/scripts/backfillTeamLogos.ts",
        "venues:import": "tsx src/scripts/importVenuesFromPlaces.ts",
        "venues:crawl-soccer": "tsx src/scripts/crawlSoccerWatchPartyVenues.ts",
        "venues:import-mapme-wc": "tsx src/scripts/importMapmeWorldCupVenues.ts",
        "venues:fill-images": "tsx src/scripts/fillVenueImages.ts",
        "venues:add-fanfest": "tsx src/scripts/addFanFestVenue.ts",
        "venues:enrich": "tsx src/scripts/enrichVenuesFromGoogle.ts",
        "venues:import-mls": "tsx src/scripts/importMlsPubPartners.ts",
        "cities:optimize": "tsx src/scripts/optimizeCityImages.ts",
        "templates:seed-jersey-parties": "tsx src/scripts/seedJerseyPartyTemplates.ts",
        "templates:seed-social-posts": "tsx src/scripts/seedSocialPostTemplates.ts"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.700.0",
        "@aws-sdk/s3-request-presigner": "^3.700.0",
        "@googlemaps/google-maps-services-js": "^3.4.2",
        "@hono/node-server": "^1.13.0",
        "@matchwatch/shared": "*",
        "@mendable/firecrawl-js": "^4.20.1",
        "bcryptjs": "^2.4.3",
        "bullmq": "^5.25.0",
        "cheerio": "^1.2.0",
        "csv-stringify": "^6.5.0",
        "date-fns": "^4.1.0",
        "date-fns-tz": "^3.2.0",
        "dotenv": "^16.4.0",
        "drizzle-orm": "^0.36.0",
        "hono": "^4.6.0",
        "ioredis": "^5.4.0",
        "isomorphic-dompurify": "^2.16.0",
        "jose": "^5.9.0",
        "nanoid": "^5.0.8",
        "pino": "^9.5.0",
        "pino-pretty": "^13.0.0",
        "postgres": "^3.4.0",
        "nodemailer": "^6.9.0",
        "resend": "^4.0.0",
        "sharp": "^0.33.5",
        "uuid": "^11.0.0",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/nodemailer": "^6.4.0",
        "@types/node": "^22.0.0",
        "@types/uuid": "^10.0.0",
        "drizzle-kit": "^0.28.0",
        "tsc-alias": "^1.8.0",
        "tsx": "^4.19.0",
        "typescript": "^5.7.0"
    }
}
