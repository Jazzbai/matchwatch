{
    "name": "@matchwatch/api",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc && tsc-alias",
        "start": "node dist/index.js",
        "type-check": "tsc --noEmit",
        "lint": "echo 'No lint configured'",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:seed": "tsx src/db/seed.ts",
        "db:seed:anonymized": "tsx src/db/seed-anonymized.ts",
        "db:studio": "drizzle-kit studio",
        "matches:sync-upcoming": "tsx src/scripts/syncUpcomingMatches.ts"
    },
    "dependencies": {
        "@matchwatch/shared": "*",
        "@hono/node-server": "^1.13.0",
        "hono": "^4.6.0",
        "drizzle-orm": "^0.36.0",
        "postgres": "^3.4.0",
        "ioredis": "^5.4.0",
        "bullmq": "^5.25.0",
        "jose": "^5.9.0",
        "bcryptjs": "^2.4.3",
        "zod": "^3.24.0",
        "@aws-sdk/client-s3": "^3.700.0",
        "@aws-sdk/s3-request-presigner": "^3.700.0",
        "resend": "^4.0.0",
        "isomorphic-dompurify": "^2.16.0",
        "sharp": "^0.33.5",
        "csv-stringify": "^6.5.0",
        "date-fns": "^4.1.0",
        "date-fns-tz": "^3.2.0",
        "pino": "^9.5.0",
        "pino-pretty": "^13.0.0",
        "nanoid": "^5.0.8",
        "uuid": "^11.0.0",
        "dotenv": "^16.4.0"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "^22.0.0",
        "@types/uuid": "^10.0.0",
        "drizzle-kit": "^0.28.0",
        "tsx": "^4.19.0",
        "tsc-alias": "^1.8.0",
        "typescript": "^5.7.0"
    }
}
