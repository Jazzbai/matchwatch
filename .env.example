# ─── Database ────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matchwatch

# ─── Redis ───────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API Server ──────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Startup Safety Switches (set false when connecting local API to production DB)
RUN_STARTUP_MIGRATIONS=true
RUN_STARTUP_SEED=true
ENABLE_MATCH_SYNC_WORKER=true

# ─── JWT (Change in production!) ─────────────────
JWT_SECRET=matchwatch-dev-secret-key-change-in-production-32chars!
COOKIE_SECURE=false
AUTO_VERIFY_EMAIL=true
AUTH_RATE_LIMIT_MAX=200
PUBLIC_RATE_LIMIT_MAX=2000

# ─── CORS ────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
APP_URL=http://localhost:3000

# ─── Frontend Proxy ──────────────────────────────
NEXT_PUBLIC_API_URL=/api/v1
API_PROXY_TARGET=http://localhost:4000

# ─── Match Sync Provider ────────────────────────
# Leave empty for auto-detect:
# - uses API_FOOTBALL when API_FOOTBALL_API_KEY is set
# - otherwise falls back to FOOTBALL_DATA
MATCH_SYNC_PROVIDER=
FOOTBALL_DATA_API_KEY=your-api-key-here
API_FOOTBALL_API_KEY=your-api-football-key-here
THE_SPORTS_DB_API_KEY=
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast

# ─── AWS S3 ──────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=matchwatch-uploads
CDN_URL=

# ─── Email (Resend) ─────────────────────────────
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=noreply@matchwatch.us

# ─── Firebase Cloud Messaging ───────────────────
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# ─── Super Admin (JazzBai) ──────────────────────
# Used by /jazzbai page and /api/v1/super-admin/*
SUPER_ADMIN_USERNAME=superadmin
# Prefer hash in production (bcrypt), fallback is plain password:
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_PASSWORD_HASH=
SUPER_ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret

