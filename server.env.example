# Copy to .env on the server before running `docker compose up -d --build`.

DATABASE_URL=postgresql://matchwatch:matchwatch_dev@postgres:5432/matchwatch
REDIS_URL=redis://redis:6379

PORT=4000
NODE_ENV=production
LOG_LEVEL=info
RUN_STARTUP_MIGRATIONS=true
RUN_STARTUP_SEED=true
ENABLE_MATCH_SYNC_WORKER=true

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
COOKIE_SECURE=true
AUTO_VERIFY_EMAIL=true
AUTH_RATE_LIMIT_MAX=200
PUBLIC_RATE_LIMIT_MAX=2000

CORS_ORIGINS=https://matchwatch.us,https://www.matchwatch.us
APP_URL=https://matchwatch.us

NEXT_PUBLIC_API_URL=/api/v1
API_PROXY_TARGET=http://api:4000
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

MATCH_SYNC_PROVIDER=API_FOOTBALL
FOOTBALL_DATA_API_KEY=
API_FOOTBALL_API_KEY=
YOUTUBE_API_KEY=
THE_SPORTS_DB_API_KEY=
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast
ESPN_SCOREBOARD_BASE_URL=https://site.api.espn.com/apis/site/v2/sports

GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1
ENTITY_ENRICHMENT_PROVIDER=generated
SERPAPI_API_KEY=
SERPAPI_LOCATION=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=matchwatch-uploads
CDN_URL=

RESEND_API_KEY=
EMAIL_FROM=noreply@matchwatch.us

FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_PASSWORD_HASH=
SUPER_ADMIN_SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
