# Add these to matchwatch-api. Keep all secrets on the server.
# For a local-network GoPro test:
MEDIAMTX_RTMP_URL=rtmp://10.0.1.6:1935
# For remote broadcasting replace the above with a public, directly reachable RTMP hostname.
MEDIAMTX_HLS_URL=https://live.matchwatch.us
MEDIAMTX_API_URL=http://10.0.1.6:9997
MEDIAMTX_PLAYBACK_URL=http://10.0.1.6:9996
MEDIAMTX_SERVICE_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
STREAM_S3_BUCKET=matchwatch-recordings
# Public HTTPS MinIO S3 API endpoint; not its administrative console.
STREAM_S3_PUBLIC_ENDPOINT=https://YOUR_PUBLIC_S3_API_HOST
# Existing S3_ENDPOINT, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION are also used.
