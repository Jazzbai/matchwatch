# Trend-aware highlight studio (docs/trend-aware-highlights.md).
# Copy these entries into .env.local and restart the development server.

# Required: video understanding. The index holds the ScorePlay media library
# (each video's ScorePlay IDs are stored in its metadata).
TWELVELABS_API_KEY=
TWELVELABS_INDEX_ID=
SCOREPLAY_API_KEY=
SCOREPLAY_API_URL=https://media.scoreplay.io/v1
# Existing MatchWatch account IDs permitted to use the team library.
SCOREPLAY_ALLOWED_USER_IDS=
# Optional user metadata field holding the ScorePlay media ID.
TWELVELABS_SCOREPLAY_ID_KEY=

# Optional: fan reactions from X recent search (server-only bearer token).
X_BEARER_TOKEN=

# Rights gate. Library or live footage is held until it is listed as licensed here.
# Comma-separated TwelveLabs index IDs whose media may be rendered into highlights.
HIGHLIGHTS_LICENSED_INDEX_IDS=
# true when the organizer's live feed is licensed for highlights.
HIGHLIGHTS_LICENSED_HLS=false

# Optional live source; never use NEXT_PUBLIC for a signed feed URL.
HIGHLIGHTS_HLS_URL=
# Exact comma-separated public HTTPS hosts, including variant and segment hosts.
HLS_ALLOWED_HOSTS=

# Optional override; ffmpeg-static supplies the executable by default.
# FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe

# Saved job outputs. Mount persistent storage here in Coolify (one replica).
# HIGHLIGHTS_DATA_DIR=/app/.data/highlight-pipeline
# Temporary render and capture files, deleted after each request.
# HIGHLIGHTS_TEMP_DIR=/tmp/matchwatch-processing

# Isolated production deployment; see ../deploy/highlights/README.md.
# Build-time:
# NEXT_PUBLIC_APP_BASE_PATH=/app
# HIGHLIGHTS_STANDALONE=true
# Runtime:
# HIGHLIGHTS_ENABLED=true
# HIGHLIGHTS_PUBLIC_ACCESS=true
# HIGHLIGHTS_PUBLIC_ORIGIN=https://matchwatch.us
# HIGHLIGHTS_SIGNING_SECRET=generate-a-random-secret-at-least-32-characters
# API_PROXY_TARGET=http://your-existing-api-private-host:4000
