# Optional AI event detection for the local highlight studio.
# Copy these entries into .env.local and restart the development server.
TWELVELABS_API_KEY=
TWELVELABS_INDEX_ID=

# ScorePlay video library (server-only; never use NEXT_PUBLIC for these).
SCOREPLAY_API_KEY=
SCOREPLAY_API_URL=https://media.scoreplay.io/v1
# Optional exact field name holding the ScorePlay media ID in TwelveLabs metadata.
# When blank, all scalar/array user-metadata values are checked.
TWELVELABS_SCOREPLAY_ID_KEY=
# Production: comma-separated MatchWatch account IDs allowed to access this library.
# Local development automatically permits the local studio.
SCOREPLAY_ALLOWED_USER_IDS=

# Optional override; ffmpeg-static supplies the executable by default.
# FFMPEG_PATH=C:/tools/ffmpeg/bin/ffmpeg.exe

# Isolated production deployment; see ../deploy/highlights/README.md.
# Build-time:
# NEXT_PUBLIC_APP_BASE_PATH=/app
# HIGHLIGHTS_STANDALONE=true
# Runtime:
# HIGHLIGHTS_ENABLED=true
# HIGHLIGHTS_PUBLIC_ORIGIN=https://matchwatch.us
# HIGHLIGHTS_SIGNING_SECRET=generate-a-random-secret-at-least-32-characters
# API_PROXY_TARGET=http://your-existing-api-private-host:4000

# X recent-search connection (server-only). Use the app Bearer Token.
X_BEARER_TOKEN=
# Comma-separated MatchWatch account IDs allowed to use this connection.
X_ALLOWED_USER_IDS=

# Saved step outputs. Mount persistent storage here in Coolify (one replica).
# HIGHLIGHTS_DATA_DIR=/app/.data/highlight-pipeline
# All local video, analysis copies and HLS segments are deleted after processing.
# HIGHLIGHTS_TEMP_DIR=/tmp/matchwatch-processing
# Organizer live source; never use NEXT_PUBLIC for a signed feed URL.
HIGHLIGHTS_HLS_URL=
# Exact comma-separated public HTTPS hosts, including variant and segment hosts.
HLS_ALLOWED_HOSTS=
# ScorePlay mapping is discovered from the shared index and cached in HIGHLIGHTS_DATA_DIR.
# No download/import override is supported for hackathon media.
